# =============================================================================
# Shield Wolf E-Commerce — Environment Variables
# Copy to .env / .env.local and fill in values. Never commit secrets.
# =============================================================================

# Application
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:5173/api
VITE_APP_URL=http://localhost:5173
VITE_API_URL=/api

# Database — production (Neon PostgreSQL)
# On Vercel: set DATABASE_URL (Neon pooled connection string with sslmode=require).
# DB_DRIVER may be omitted when DATABASE_URL is set; it defaults to postgres.
# Explicitly set DB_DRIVER=postgres in production for clarity.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Database — local development (SQLite)
# Set DB_DRIVER=sqlite for local/offline development.
# PostgreSQL/Neon remains the production source of truth.
# Do NOT attempt automatic bidirectional sync between SQLite and PostgreSQL.
# Requires optional package: npm install better-sqlite3
DB_DRIVER=sqlite
SQLITE_PATH=./database/local/shield_wolf.sqlite

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Development seed admin (never use these values in production)
SEED_ADMIN_EMAIL=admin@shieldwolf.local
SEED_ADMIN_PASSWORD=ChangeMeNow!123
ALLOW_PROD_SEED_ADMIN=false

# CORS — set to the public site origin in production (e.g. https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Media storage abstraction (cloudinary | vercel_blob | local)
MEDIA_PROVIDER=local
MEDIA_CLOUD_NAME=
MEDIA_API_KEY=
MEDIA_API_SECRET=
MEDIA_UPLOAD_PRESET=
BLOB_READ_WRITE_TOKEN=

# Email (provider-agnostic)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@shieldwolf.lr
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Payments (provider-agnostic; manual MoMo verification by default)
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=
MTN_MOMO_NUMBER=
ORANGE_MONEY_NUMBER=
PAYMENT_EVIDENCE_ENABLED=true

# Notifications
NOTIFICATION_CHANNELS=in_app,email

# Security
SESSION_COOKIE_SECURE=false
CSRF_SECRET=change-me-csrf-secret

# -----------------------------------------------------------------------------
# Vercel production checklist (Project → Settings → Environment Variables)
# -----------------------------------------------------------------------------
# Required:
#   NODE_ENV=production
#   DATABASE_URL=<Neon pooled URL>
#   DB_DRIVER=postgres
#   JWT_SECRET=<long random secret — not the example value>
#   APP_URL=https://YOUR_DOMAIN
#   API_URL=https://YOUR_DOMAIN/api
#   CORS_ORIGIN=https://YOUR_DOMAIN
#   VITE_APP_URL=https://YOUR_DOMAIN
#   VITE_API_URL=/api
# Recommended:
#   EMAIL_FROM, MEDIA_PROVIDER (+ credentials), SESSION_COOKIE_SECURE=true
# Never set ALLOW_PROD_SEED_ADMIN=true in production.
